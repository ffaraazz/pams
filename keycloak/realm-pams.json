{
  "realm": "pams",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "HR",
        "description": "Human Resources — full access to all resources"
      },
      {
        "name": "ProjectManager",
        "description": "Project Manager — can manage allocations for own projects"
      },
      {
        "name": "Staff",
        "description": "Staff — can view own allocations and profile"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pams-api",
      "name": "PAMS API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "pams-web",
      "name": "PAMS Web Client",
      "description": "Frontend SPA client for PAMS",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5195/*",
        "http://localhost:5195/scalar/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5195"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "empCode",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "empCode",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "empCode",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "pams-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pams-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "hr.admin",
      "email": "hr.admin@pams.local",
      "firstName": "HR",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "empCode": ["EMP-001"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["HR"]
    },
    {
      "username": "pm.alice",
      "email": "pm.alice@pams.local",
      "firstName": "Alice",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "empCode": ["EMP-002"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ProjectManager"]
    },
    {
      "username": "staff.bob",
      "email": "staff.bob@pams.local",
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "empCode": ["EMP-003"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["Staff"]
    }
  ]
}
